{
  "manifest_version": 3,
  "name": "CozyLock — Cozy Corner Focus Lock",
  "version": "2.0.0",
  "description": "Browser-level focus lock for Cozy Corner — blocks distracting websites during focus timer sessions",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "activeTab",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content/overlay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "CozyLock Focus Lock"
  },
  "externally_connectable": {
    "matches": [
      "https://cozyycorner.vercel.app/*",
      "https://*.vercel.app/*",
      "http://localhost:3000/*",
      "http://localhost:5173/*",
      "http://localhost:5500/*",
      "http://localhost:8080/*",
      "http://localhost:8000/*",
      "http://127.0.0.1:3000/*",
      "http://127.0.0.1:5500/*"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
